# TechReel AI - Backend Environment Configuration

# MongoDB Atlas Connection String (Never commit real passwords to Git)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority&appName=Cluster0
DATABASE_NAME=techreel

# AI Provider API Keys (Optional - runs in deterministic mode if unset)
AI_API_KEY=
AI_MODEL=gemini-1.5-flash

# Embeddings Configuration
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-004

# Application & CORS
FRONTEND_URL=http://localhost:3000
DEMO_MODE=true
LOG_LEVEL=INFO
